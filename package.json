{
  "name": "nocontext",
  "version": "0.0.0",
  "description": "Measures whether an agent can actually reach the right document in your corpus.",
  "type": "module",
  "bin": {
    "nocontext": "./dist/surfaces/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "PLANNER.md",
    "CONTRIBUTING.md",
    "docs/ARCHITECTURE.md",
    "docs/METHOD.md",
    "docs/PROBES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build",
    "test": "npm run clean && tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples": "python3 examples/build.py"
  },
  "keywords": [
    "ai-agents",
    "rag",
    "retrieval",
    "evaluation",
    "documentation",
    "llm",
    "okf"
  ],
  "license": "MIT",
  "author": "Pawan Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawankumar94/nocontext.git"
  },
  "homepage": "https://github.com/pawankumar94/nocontext#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "onnxruntime-node": "1.29.0",
    "sharp": "0.35.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources/filesystem.d.ts",
      "import": "./dist/sources/filesystem.js"
    }
  }
}
