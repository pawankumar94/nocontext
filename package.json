{
  "name": "nocontext",
  "version": "0.0.0",
  "description": "Measures whether an agent can actually reach the right document in your corpus.",
  "type": "module",
  "bin": {
    "nocontext": "./dist/surfaces/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/METHOD.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples": "python3 examples/build.py"
  },
  "keywords": [
    "ai-agents",
    "rag",
    "retrieval",
    "evaluation",
    "documentation",
    "llm",
    "okf"
  ],
  "license": "MIT",
  "author": "Pawan Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawankumar94/nocontext.git"
  },
  "homepage": "https://github.com/pawankumar94/nocontext#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources/filesystem.d.ts",
      "import": "./dist/sources/filesystem.js"
    }
  }
}
